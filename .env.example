# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---- DeepSeek LLM ----
# NOTE: triage sends a code snippet and fix generation sends the WHOLE affected
# file to DeepSeek. For private repos that is third-party data egress — see
# docs/concerns.md. LLM_ENABLED=false is the hard off switch (scans still run).
DEEPSEEK_API_KEY=
# deepseek-v4-flash (fast) or deepseek-v4-pro. The legacy deepseek-chat /
# deepseek-reasoner ids deprecate 2026-07-24 — don't use them.
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=120
LLM_ENABLED=true
# The auto-fix severity floor is per-scan (chosen in the UI) and defaults to
# "none" — no patch is written unless you ask for one. It is not an env var.

# ---- Postgres ----
# When running Postgres via deps.compose.yml, use localhost:5433 (NOT 5432).
POSTGRES_DB=sentriq
POSTGRES_USER=sentriq
POSTGRES_PASSWORD=sentriq
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---- Redis (Celery broker + result backend) ----
# When running Redis via deps.compose.yml, use localhost:6380 (NOT 6379).
REDIS_URL=redis://localhost:6380/0
# Hard ceiling on a single scan; also the age at which a RUNNING scan is
# considered orphaned and reaped (see sentriq.reap_orphaned_scans).
CELERY_TASK_TIME_LIMIT=3600

# ---- Scan execution ----
# Absolute path shared by host and worker at the SAME path — nested
# `docker run -v` resolves it on the host daemon. See docker-compose.yml.
HOST_DATA_DIR=/tmp/sentriq-data
# "host" reaches localhost/staging targets on Linux; "bridge" for public URLs.
SCANNER_NETWORK=host
TOOL_TIMEOUT_SECONDS=900
CLONE_TIMEOUT_SECONDS=300
# GitHub/GitLab PAT (repo scope): clones PRIVATE repos and pushes AI-fix
# branches. PR creation prefers the acting user's own OAuth token and only
# falls back to this. Note this single credential can write to every repo it
# can see — docs/concerns.md #1.
SENTRIQ_GIT_TOKEN=

# ---- GitHub OAuth (Login with GitHub) ----
# Register an OAuth App at https://github.com/settings/developers
# Authorization callback URL must match GITHUB_OAUTH_REDIRECT_URI exactly.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ---- Sessions / auth ----
# Session lifetime in seconds (default 8h). Expiry slides on each request, so
# an active user is not logged out mid-session. Django's own default is 14
# DAYS, which is why a login could appear to persist "forever".
SESSION_COOKIE_AGE=28800
# MUST be true anywhere served over TLS. false is only correct for local HTTP.
SESSION_COOKIE_SECURE=false

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Django ----
DJANGO_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
# 32-byte Fernet key encrypting stored GitHub OAuth tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes every stored token undecryptable (users must re-login).
TOKEN_ENCRYPTION_KEY=
LOG_LEVEL=INFO
