# Copy to .env and fill in. .env is gitignored.

# ---- DeepSeek LLM ----
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_ENABLED=true
# Auto-fix severity floor is per-scan (chosen in the UI), not set here.

# ---- Postgres ----
# When running Postgres via deps.compose.yml, use localhost.
POSTGRES_DB=sentriq
POSTGRES_USER=sentriq
POSTGRES_PASSWORD=sentriq
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ---- Redis ----
# When running Redis via deps.compose.yml, use localhost.
REDIS_URL=redis://localhost:6380/0

# ---- Scan execution ----
HOST_DATA_DIR=/tmp/opencode/sentriq-data
SCANNER_NETWORK=host
TOOL_TIMEOUT_SECONDS=900
# GitHub/GitLab PAT: clone PRIVATE repos AND push AI-fix PRs. repo scope.
SENTRIQ_GIT_TOKEN=

# ---- GitHub OAuth (Login with GitHub) ----
# Register an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Frontend ----
FRONTEND_URL=http://localhost:3000

# ---- Django ----
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-in-production
# 32-byte Fernet key for encrypting stored GitHub tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
LOG_LEVEL=INFO
