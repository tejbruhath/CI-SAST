# Copy to .env and edit.

# Public domain that resolves to this master node (used for TLS + server_name).
# For a pure local/HTTP test you can leave it as localhost and skip certbot.
DOMAIN=sast.example.com

# Email for Let's Encrypt registration / expiry notices.
LETSENCRYPT_EMAIL=you@example.com

# Host path of the master-node artifacts backup PV (where ci-utils' finished
# mega-artifact.json files are archived, one dir per job_id).
# e.g. /data/sast-artifacts-backup
ARTIFACTS_DIR=./artifacts

# Use Let's Encrypt staging while testing to avoid rate limits (1) or prod (0).
STAGING=1
